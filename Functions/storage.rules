rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is owner
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper: validate image file type and size
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
             && request.resource.size < 5 * 1024 * 1024; // Max 5MB
    }
    
    // -------------------------------------------------------------------------
    // 1. Profile Pictures (profile_pics/{userId}/...)
    // -------------------------------------------------------------------------
    // - Read: Public (everyone can view profile pics for leaderboards etc.)
    // - Write: Only the authenticated user can upload to their own folder
    //          with valid image type and size limit
    match /profile_pics/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(userId) && isValidImage();
    }

    // -------------------------------------------------------------------------
    // 2. Geometric Bodies (geometricBodies/... and legacy goemetricBodies/...)
    // -------------------------------------------------------------------------
    // - Read: Public
    // - Write: Denied (admin uploads via Admin SDK which bypasses rules)
    match /geometricBodies/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Support for potential initial typo/legacy in requirements
    match /goemetricBodies/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // 3. Lecture Pictures (MathCH1, MathCH2, etc.)
    // -------------------------------------------------------------------------
    // - Read: Public for lecture content
    // - Write: Denied (admin uploads via Admin SDK)
    match /{folderName}/{allPaths=**} {
      allow read: if folderName.matches('MathCH[0-9]+');
      allow write: if false;
    }
    
    // Default deny for everything else is implicit if no match
  }
}
