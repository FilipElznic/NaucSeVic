rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.admin == true;
    }
    
    // Users collection - users can read and write their own data
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if isOwner(userId);
      
      // Allow users to create their own profile (during registration)
      allow create: if isOwner(userId) && 
                      request.resource.data.keys().hasAll(['profile', 'completedTasks', 'progress']) &&
                      request.resource.data.profile.keys().hasAll(['name', 'surname', 'email', 'xp', 'coins']);
      
      // Allow users to update their own profile
      allow update: if isOwner(userId);
      
      // Allow users to delete their own profile
      allow delete: if isOwner(userId);
      
      // Admins can read/write all users
      allow read, write: if isAdmin();
    }
    
    // Tasks collection
    match /tasks/{taskId} {
      // Anyone can read tasks (even unauthenticated users for demo)
      allow read: if true;
      
      // Only authenticated users can create tasks
      allow create: if isAuthenticated();
      
      // Only task owner or admin can update
      allow update: if isAuthenticated() && 
                      (resource.data.userId == request.auth.uid || isAdmin());
      
      // Only task owner or admin can delete
      allow delete: if isAuthenticated() && 
                      (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // User progress tracking (subcollection or separate collection)
    match /progress/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Task attempts/submissions
    match /taskAttempts/{attemptId} {
      allow read: if isAuthenticated() && 
                    (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // Admin-only collections
    match /adminData/{document=**} {
      allow read, write: if isAdmin();
    }

    // Geometric Bodies collection
    match /geometricBodies/{bodyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
