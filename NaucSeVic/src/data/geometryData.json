      "spline_url": "https://prod.spline.design/xHk11UuRR4ODhHhx/scene.splinecode",
      "image_url": "https://bviuhriolcuvayzbgzum.supabase.co/storage/v1/object/public/Telesa//krychlebg.png"
    },
    "formulas": {
      "volume": {
        "name": "Objem",
        "formula": "a^3"
      },
      "surface": {
        "name": "Povrch",
        "formula": "6 \\cdot a^2"
      },
      "diagonal_face": {
        "name": "Stěnová úhlopříčka",
        "formula": "a \\cdot \\sqrt{2}"
      },
      "diagonal_body": {
        "name": "Tělesová úhlopříčka",
        "formula": "a \\cdot \\sqrt{3}"
      }
    }
  },
  {
    "id": "kvadr",
    "name": "Kvádr",
    "type": "3d",
    "description": "Kvádr je trojrozměrné těleso složené ze šesti obdélníkových stěn. Protilehlé stěny jsou rovnoběžné a shodné. Má tři rozměry: délku, šířku a výšku. Všechny vnitřní úhly mezi stěnami jsou pravé.",
    "assets": {
      "spline_url": "https://prod.spline.design/qE3w6N6yjixh-SZI/scene.splinecode",
      "image_url": "https://bviuhriolcuvayzbgzum.supabase.co/storage/v1/object/public/Telesa//kvadrbg.png"
    },
    "formulas": {
      "volume": {
        "name": "Objem",
        "formula": "a \\cdot b \\cdot c"
      },
      "surface": {
        "name": "Povrch",
        "formula": "2 \\cdot (a \\cdot b + a \\cdot c + b \\cdot c)"
      },
      "diagonal_body": {
        "name": "Tělesová úhlopříčka",
        "formula": "\\sqrt{a^2 + b^2 + c^2}"
      }
    }
  },
